# Development/Testing - Local Hardhat Network
# (No keys needed - tests will run with defaults)

# Testnet Deployment (Optional - only needed for Rinkeby/Sepolia deployment)
ALCHEMY_RINKEBY_API_URL=https://eth-rinkeby.alchemyapi.io/v2/YOUR_API_KEY_HERE
DEV_PRIVATE_KEY=your_dev_wallet_private_key_here

# Mainnet Deployment (Required for production deployment)
INFURA_API_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
PROD_PRIVATE_KEY=your_production_wallet_private_key_here

# Contract Verification (Optional - for Etherscan verification)
ETHERSCAN_KEY=your_etherscan_api_key_here

# Gas Reporting (Optional - for USD gas cost estimates)
COINMARKETCAP_KEY=your_coinmarketcap_api_key_here

# ⚠️  SECURITY WARNING ⚠️
# NEVER commit your actual .env file with real private keys!
# Add .env to your .gitignore
# Use a separate wallet for development/testing
